# Supabase (Project Settings → API). Region: Singapore.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by cron endpoints to deliver notifications.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (Railway domain until the final domain is chosen)
NEXT_PUBLIC_SITE_URL=https://tali.up.railway.app

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts bank account numbers, phone numbers and shipping addresses.
DATA_ENCRYPTION_KEY=

# Shared secret for /api/cron/* (Railway cron sends it as a Bearer token)
CRON_SECRET=

# Optional: email notifications via Resend
RESEND_API_KEY=
EMAIL_FROM="Tali <notifikasi@example.com>"

# Optional: Web Push. Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:halo@example.com

# Optional: brand contact on the landing page ("Saya brand / agensi")
# WhatsApp number in international format, digits only (e.g. 62812...)
CONTACT_WA=
CONTACT_EMAIL=
